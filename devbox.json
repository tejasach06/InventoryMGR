{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
  "packages": [
    "rustc@latest",
    "cargo@latest",
    "cargo-audit@latest",
    "python@3.13",
    "uv@latest",
    "nodejs@26.8.0",
    "postgresql@17",
    "just@latest"
  ],
  "env": {
    "DATABASE_URL":      "postgresql://inventorymgr@127.0.0.1:54329/inventorymgr",
    "TEST_DATABASE_URL": "postgresql://inventorymgr@127.0.0.1:54329/inventorymgr_test"
  },
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.nub/bin:$HOME/.local/bin:$PATH\""
    ],
    "scripts": {
      "setup": [
        "(cd backend-rust && cargo build --locked)",
        "(cd backend && uv sync --extra dev)",
        "[ -x \"$HOME/.nub/bin/nub\" ] || (curl -fsSL https://nubjs.com/install.sh | bash)",
        "(cd frontend && nub install)"
      ]
    }
  }
}
